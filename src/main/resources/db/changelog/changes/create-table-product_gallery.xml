<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1772676845342-1" author="emman">
        <createTable tableName="product_gallery">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_product_gallery"/>
            </column>
            <column name="public_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="original_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="thumbnail_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="medium_url" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="alt_text" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="floral_arrangement_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="is_primary" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772676845342-2" author="emman">
        <addUniqueConstraint columnNames="public_id" constraintName="uc_product_gallery_publicid"
                             tableName="product_gallery"/>
    </changeSet>
    <changeSet id="1772676845342-3" author="emman">
        <addForeignKeyConstraint baseColumnNames="floral_arrangement_id" baseTableName="product_gallery"
                                 constraintName="FK_PRODUCT_GALLERY_ON_FLORALARRANGEMENT" referencedColumnNames="id"
                                 referencedTableName="floral_arrangements"/>
    </changeSet>

</databaseChangeLog>