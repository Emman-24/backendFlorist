<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1773351920518-1" author="emman">
        <createTable tableName="flowers">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_flowers"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="meaning" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="floral_arrangement_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>
    <changeSet id="1773351920518-2" author="emman">
        <addForeignKeyConstraint baseColumnNames="floral_arrangement_id" baseTableName="flowers"
                                 constraintName="FK_FLOWERS_ON_FLORAL_ARRANGEMENT" referencedColumnNames="id"
                                 referencedTableName="floral_arrangements"/>
    </changeSet>

</databaseChangeLog>